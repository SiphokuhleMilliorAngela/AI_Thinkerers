# Optional local overrides. The prototype works without an .env file.
# Set these as shell environment variables before `npm run dev` if needed.
AVVA_API_HOST=127.0.0.1
AVVA_API_PORT=8787
AVVA_DASHBOARD_URL=http://127.0.0.1:5173
VITE_AVVA_API_URL=http://127.0.0.1:8787
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://your-api.example
VITE_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
VITE_OPENROUTER_MODEL=openai/gpt-4o
VITE_OPENROUTER_MAX_COMPLETION_TOKENS=400
VITE_OPENROUTER_MAX_TABS=4
VITE_OPENROUTER_MAX_TAB_TEXT_CHARACTERS=2500
VITE_OPENROUTER_SITE_URL=http://localhost:5173
VITE_OPENROUTER_SITE_NAME=av
TOOL_SERVER_PORT=8787
